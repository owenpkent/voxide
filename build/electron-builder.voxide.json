{
  "appId": "com.okstudio.voxide",
  "productName": "VoxIDE",
  "directories": {
    "output": "release-voxide"
  },
  "extraMetadata": {
    "name": "voxide",
    "version": "1.0.0",
    "description": "VoxIDE — Voice-Controlled Accessible IDE",
    "main": "dist/main/main-voxide.js"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "resources/icons",
      "to": "icons"
    },
    {
      "from": "resources/earcons",
      "to": "earcons"
    },
    {
      "from": "native/voxide-audio",
      "to": "native/voxide-audio",
      "filter": ["*.node", "index.d.ts", "package.json"]
    }
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "assets/icon.ico",
    "signtoolOptions": {
      "publisherName": "OK Studio Inc.",
      "certificateSha1": "fc22b5221318f3f3f6b3eb2d969d7f99091557bf",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com",
      "sign": "build/sign.js"
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": true,
    "allowElevation": true,
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "installerHeaderIcon": "assets/icon.ico",
    "deleteAppDataOnUninstall": true,
    "runAfterFinish": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "menuCategory": "VoxIDE",
    "shortcutName": "VoxIDE",
    "guid": "voxide-accessible-ide",
    "include": "build/installer-voxide.nsh"
  }
}
